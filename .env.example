# ---------------------------------------------------------------------------
# Configuración de la aplicación
# Copia este fichero como `.env` y ajusta los valores.
# ---------------------------------------------------------------------------

# Backend de Bedrock: "mock" (simulado, sin AWS) | "aws" (llamadas reales)
BEDROCK_BACKEND=mock

# Región de AWS. Solo se usa cuando BEDROCK_BACKEND=aws.
# us-east-1 y us-west-2 son las regiones con mayor cobertura de modelos.
AWS_REGION=us-east-1

# Perfil de credenciales del AWS CLI (opcional; por defecto usa la cadena
# estándar de resolución de credenciales de boto3).
# AWS_PROFILE=default

# Semilla por defecto para la generación de imágenes.
# Fijarla hace reproducibles los resultados; 0 = aleatoria en cada ejecución.
DEFAULT_SEED=0

# Activa el índice RAG sobre la guía de estilo de marca.
RAG_ENABLED=true
